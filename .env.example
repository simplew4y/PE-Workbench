# PE Workbench multi-user gateway. Do not commit the real session secret.
PE_MULTI_USER_MODE=0
PE_USER_ROOT=/home/pi
PE_BACKEND_URL=https://capoo.fun/pe_workbench/backend
PE_GATEWAY_DATABASE_PATH=/srv/pe-workbench/gateway/gateway.sqlite3
# Generate with: openssl rand -hex 32
PE_SESSION_SECRET=replace-with-64-hex-characters
PE_SESSION_TTL_HOURS=168
PE_BACKEND_TIMEOUT_SECONDS=10
PE_SESSION_COOKIE_NAME=pe_workbench_session
PE_SESSION_COOKIE_PATH=/pe_workbench
PE_SESSION_COOKIE_SECURE=true

# Per-user worker orchestration. Gateway runs on the Docker host and reaches
# workers only through ephemeral ports bound to 127.0.0.1.
# Use `bind` on a native Linux host. Use `volume` for WSL + Docker Desktop when
# Docker cannot bind-mount the WSL distribution's /home paths.
PE_WORKER_STORAGE=bind
PE_WORKER_IMAGE=pe-workbench-worker:local
PE_WORKER_DATA_ROOT=/srv/pe-workbench/users
PE_WORKER_IDLE_MINUTES=30
PE_WORKER_CAPABILITY_TTL_HOURS=168
PE_WORKER_START_TIMEOUT_SECONDS=120
PE_WORKER_CPU_LIMIT=2
PE_WORKER_MEMORY_MB=4096
PE_WORKER_PIDS_LIMIT=256
PE_WORKER_UID=1000
PE_WORKER_GID=1000
# Usually `docker`; WSL + Docker Desktop development can use `docker.exe`.
PE_DOCKER_COMMAND=docker
