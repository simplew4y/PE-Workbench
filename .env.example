# PE Workbench local account bridge. Do not commit the real session secret.
PE_MULTI_USER_MODE=1
# Leave PE_USER_ROOT unset to use the current Linux user's home directory.
# PE_USER_ROOT=/home/your-user
PE_BACKEND_URL=https://capoo.fun/pe_workbench/backend
PE_GATEWAY_DATABASE_PATH=/home/your-user/.pi/agent/pe-workbench/account.sqlite3
# Generate with: openssl rand -hex 32
PE_SESSION_SECRET=replace-with-64-hex-characters
PE_SESSION_TTL_HOURS=168
PE_BACKEND_TIMEOUT_SECONDS=10
PE_SESSION_COOKIE_NAME=pe_workbench_session
PE_SESSION_COOKIE_PATH=/
PE_SESSION_COOKIE_SECURE=false
