{
	"name": "@earendil-works/pe-boot",
	"version": "0.84.2",
	"description": "PE-Workbench SDK application built on pi-coding-agent",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./framework-report": { "types": "./dist/research/report.d.ts", "import": "./dist/research/report.js", "default": "./dist/research/report.js" },
		"./documents": { "types": "./dist/documents.d.ts", "import": "./dist/documents.js", "default": "./dist/documents.js" },
		"./schema": { "types": "./dist/collection-schema.d.ts", "import": "./dist/collection-schema.js", "default": "./dist/collection-schema.js" },
		"./source": { "types": "./dist/source.d.ts", "import": "./dist/source.js", "default": "./dist/source.js" },
		"./evidence": { "types": "./dist/evidence.d.ts", "import": "./dist/evidence.js", "default": "./dist/evidence.js" }
		,"./workbook-reader": { "types": "./dist/workbook-reader.d.ts", "import": "./dist/workbook-reader.js", "default": "./dist/workbook-reader.js" }
		,"./workbook-text": { "types": "./dist/workbook-text.d.ts", "import": "./dist/workbook-text.js", "default": "./dist/workbook-text.js" }
	},
	"bin": {
		"pe-boot": "dist/cli.js"
	},
	"files": [
		"dist",
		"skills",
		"python"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"setup:python": "node python/setup.mjs",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@embedpdf/fonts-sc": "1.0.0",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"pdfkit": "0.20.1",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/pdfkit": "0.17.6"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
