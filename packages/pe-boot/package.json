{
	"name": "@earendil-works/pe-boot",
	"version": "0.84.2",
	"description": "PE-Workbench SDK application built on pi-coding-agent",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"pe-boot": "dist/cli.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@embedpdf/fonts-sc": "1.0.0",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"pdfkit": "0.20.1",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/pdfkit": "0.17.6"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
