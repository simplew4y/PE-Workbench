{
	"name": "@earendil-works/financial-information-service",
	"version": "0.84.2",
	"description": "Independent official financial disclosure collection and delivery service",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"pe-financial-information": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"dev": "tsx src/cli.ts",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
