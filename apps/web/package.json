{
  "name": "@agegr/pi-web",
  "version": "0.8.9",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "dist/pe-ingest",
    "services/session-attachments",
    "services/pe-analysis",
    "services/pe-research",
    "!services/pe-analysis/**/__pycache__",
    "!services/pe-analysis/**/*.pyc",
    "!services/pe-analysis/test_*.py",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "research:doctor": "node scripts/research-doctor.mjs",
    "research:worker": "node services/pe-research/worker.mjs",
    "build:pe-boot": "npm --prefix ../.. run build:offline",
    "build:pe-ingest": "node scripts/build-pe-ingest-worker.mjs",
    "dev": "npm run build:pe-boot && npm run build:pe-ingest && next dev --turbopack -H 127.0.0.1 -p 30141",
    "dev:lan": "npm run build:pe-boot && npm run build:pe-ingest && next dev --turbopack -H 0.0.0.0 -p 30141",
    "dev:webpack": "npm run build:pe-boot && npm run build:pe-ingest && WATCHPACK_POLLING=1000 next dev --webpack -H 127.0.0.1 -p 30141",
    "dev:lan:webpack": "npm run build:pe-boot && npm run build:pe-ingest && WATCHPACK_POLLING=1000 next dev --webpack -H 0.0.0.0 -p 30141",
    "build": "npm run build:pe-boot && npm run build:pe-ingest && next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "eval:generative-ui": "node --experimental-strip-types scripts/evaluate-generative-ui.mjs",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@earendil-works/pe-boot": "0.84.2",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@napi-rs/canvas": "1.0.8",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@streamdown/cjk": "1.0.3",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.40.0",
    "next": "16.3.1",
    "pdfjs-dist": "6.3.289",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shadcn": "^4.20.1",
    "streamdown": "2.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "8.10.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
